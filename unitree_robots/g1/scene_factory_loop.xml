<mujoco model="g1_29dof L-shaped loop factory">
  <include file="g1_29dof.xml"/>

  <!-- Main hall: x=-20..20, y=-9..9. North wing: x=8..20, y=9..23. -->
  <statistic center="0 5 1.5" extent="29"/>
  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <rgba haze="0.12 0.18 0.25 1"/>
    <global azimuth="-120" elevation="-28"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.30 0.48 0.65" rgb2="0.05 0.07 0.09" width="512" height="3072"/>
    <texture type="2d" name="loop_floor_tex" builtin="checker" mark="edge"
             rgb1="0.35 0.36 0.37" rgb2="0.28 0.29 0.30" markrgb="0.70 0.70 0.70"
             width="300" height="300"/>
    <material name="loop_floor_mat" texture="loop_floor_tex" texuniform="true" texrepeat="14 7" reflectance="0.08"/>
    <material name="loop_wall_mat" rgba="0.70 0.73 0.75 1"/>
    <material name="loop_room_mat" rgba="0.57 0.63 0.68 1"/>
    <material name="loop_roof_mat" rgba="0.38 0.41 0.45 1"/>
    <material name="loop_beam_mat" rgba="0.26 0.29 0.34 1"/>
    <material name="loop_machine_mat" rgba="0.18 0.37 0.48 1"/>
    <material name="loop_orange_mat" rgba="0.89 0.41 0.08 1"/>
    <material name="loop_blue_mat" rgba="0.22 0.33 0.63 1"/>
    <material name="loop_shelf_mat" rgba="0.67 0.69 0.70 1"/>
    <material name="loop_wood_mat" rgba="0.65 0.45 0.25 1"/>
    <material name="loop_dark_mat" rgba="0.08 0.09 0.11 1"/>
    <material name="loop_yellow_mat" rgba="0.92 0.78 0.12 1"/>
    <material name="loop_worker_mat" rgba="0.18 0.47 0.72 1"/>
    <material name="loop_skin_mat" rgba="0.70 0.52 0.39 1"/>
  </asset>

  <worldbody>
    <light pos="-12 -2 4.1" dir="0 0 -1" directional="true" diffuse="0.75 0.75 0.75"/>
    <light pos="7 2 4.1" dir="0 0 -1" directional="false" diffuse="0.40 0.40 0.40"/>
    <light pos="17 -3 4.1" dir="0 0 -1" directional="false" diffuse="0.35 0.35 0.35"/>
    <light pos="14 17 4.1" dir="0 0 -1" directional="false" diffuse="0.40 0.40 0.40"/>
    <geom name="floor" type="plane" size="22 24 0.05" material="loop_floor_mat"/>

    <!-- All roof and beam names use the existing show_factory_roof filter. -->
    <geom name="roof_west" type="box" pos="-10 0 4.0" size="10 9 0.06" material="loop_roof_mat"/>
    <geom name="roof_east" type="box" pos="10 0 4.0" size="10 9 0.06" material="loop_roof_mat"/>
    <geom name="roof_wing" type="box" pos="14 16 4.0" size="6 7 0.06" material="loop_roof_mat"/>
    <geom name="roof_room" type="box" pos="8 0.5 3.25" size="5 3.5 0.07" material="loop_roof_mat"/>
    <geom name="beam_north_w" type="box" pos="-10 5.8 3.82" size="10 0.11 0.12" material="loop_beam_mat"/>
    <geom name="beam_north_e" type="box" pos="10 5.8 3.82" size="10 0.11 0.12" material="loop_beam_mat"/>
    <geom name="beam_south_w" type="box" pos="-10 -5.9 3.82" size="10 0.11 0.12" material="loop_beam_mat"/>
    <geom name="beam_south_e" type="box" pos="10 -5.9 3.82" size="10 0.11 0.12" material="loop_beam_mat"/>
    <geom name="beam_cross_w" type="box" pos="-11 0 3.82" size="0.11 9 0.12" material="loop_beam_mat"/>
    <geom name="beam_cross_e" type="box" pos="16 0 3.82" size="0.11 9 0.12" material="loop_beam_mat"/>
    <geom name="beam_wing_west" type="box" pos="9.7 16 3.82" size="0.11 7 0.12" material="loop_beam_mat"/>
    <geom name="beam_wing_north" type="box" pos="14 21.2 3.82" size="6 0.11 0.12" material="loop_beam_mat"/>

    <!-- L-shaped enclosure. The 12 m opening at y=9 joins the north wing. -->
    <geom name="outer_south" type="box" pos="0 -9 1.85" size="20 0.15 1.85" material="loop_wall_mat"/>
    <geom name="outer_north" type="box" pos="-6 9 1.85" size="14 0.15 1.85" material="loop_wall_mat"/>
    <geom name="outer_west" type="box" pos="-20 0 1.85" size="0.15 9 1.85" material="loop_wall_mat"/>
    <geom name="outer_east" type="box" pos="20 7 1.85" size="0.15 16 1.85" material="loop_wall_mat"/>
    <geom name="wing_west" type="box" pos="8 16 1.85" size="0.15 7 1.85" material="loop_wall_mat"/>
    <geom name="wing_north" type="box" pos="14 23 1.85" size="6 0.15 1.85" material="loop_wall_mat"/>

    <!-- Central closed room spans x=3..13, y=-3..4. A 1.8 m doorway is
         cut into the south wall at x=9.4..11.2. The door leaf is open inside. -->
    <geom name="room_west" type="box" pos="3 0.5 1.55" size="0.12 3.5 1.55" material="loop_room_mat"/>
    <geom name="room_east" type="box" pos="13 0.5 1.55" size="0.12 3.5 1.55" material="loop_room_mat"/>
    <geom name="room_north" type="box" pos="8 4 1.55" size="5 0.12 1.55" material="loop_room_mat"/>
    <geom name="room_south_left" type="box" pos="6.2 -3 1.55" size="3.2 0.12 1.55" material="loop_room_mat"/>
    <geom name="room_south_right" type="box" pos="12.1 -3 1.55" size="0.9 0.12 1.55" material="loop_room_mat"/>
    <geom name="room_door_lintel" type="box" pos="10.3 -3 2.83" size="0.9 0.13 0.28" material="loop_room_mat"/>
    <geom name="room_door_open" type="box" pos="9.55 -2.15 1.03" size="0.07 0.82 1.03" material="loop_blue_mat"/>
    <geom name="room_window_w" type="box" pos="2.88 0.3 2.04" size="0.03 0.78 0.42" material="loop_dark_mat"/>
    <geom name="room_window_e" type="box" pos="13.12 1.7 2.0" size="0.03 0.55 0.38" material="loop_dark_mat"/>
    <geom name="room_desk" type="box" pos="5.0 1.7 0.40" size="1.05 0.58 0.40" material="loop_wood_mat"/>
    <geom name="room_cabinet" type="box" pos="11.9 2.6 0.93" size="0.52 0.55 0.93" material="loop_blue_mat"/>
    <geom name="room_server" type="box" pos="11.9 -1.4 1.05" size="0.46 0.47 1.05" material="loop_dark_mat"/>

    <!-- Perimeter features are deliberately different on each side. The
         ring x=0..16, y=-6..7 around the room remains walkable. -->
    <geom name="north_cabinet_tall" type="box" pos="-4.0 7.8 1.15" size="0.55 0.56 1.15" material="loop_blue_mat"/>
    <geom name="north_cabinet_low" type="box" pos="-1.9 7.8 0.72" size="0.75 0.50 0.72" material="loop_shelf_mat"/>
    <geom name="north_drum" type="cylinder" pos="0.2 7.6 0.62" size="0.32 0.62" material="loop_orange_mat"/>
    <geom name="north_pallet" type="box" pos="5.7 7.7 0.12" size="0.73 0.54 0.12" material="loop_wood_mat"/>
    <geom name="north_pallet_load" type="box" pos="5.7 7.7 0.52" size="0.55 0.40 0.28" material="loop_wood_mat"/>
    <geom name="north_pipe_tank" type="cylinder" pos="17.8 7.6 1.02" size="0.45 1.02" material="loop_machine_mat"/>
    <geom name="north_pipe" type="capsule" pos="17.8 7.6 2.25" size="0.09 0.70" euler="0 90 0" material="loop_yellow_mat"/>

    <!-- Eastern side: forklift is parked against the wall, leaving the loop aisle open. -->
    <geom name="forklift_chassis" type="box" pos="18.0 0.7 0.48" size="0.90 0.56 0.38" material="loop_orange_mat"/>
    <geom name="forklift_counterweight" type="box" pos="18.0 1.35 0.70" size="0.72 0.24 0.48" material="loop_orange_mat"/>
    <geom name="forklift_guard" type="box" pos="18.0 0.85 1.98" size="0.74 0.52 0.07" material="loop_dark_mat"/>
    <geom name="forklift_mast_l" type="box" pos="17.6 -0.35 1.06" size="0.08 0.08 1.06" material="loop_dark_mat"/>
    <geom name="forklift_mast_r" type="box" pos="18.4 -0.35 1.06" size="0.08 0.08 1.06" material="loop_dark_mat"/>
    <geom name="forklift_fork_l" type="box" pos="17.6 -1.08 0.13" size="0.08 0.80 0.07" material="loop_shelf_mat"/>
    <geom name="forklift_fork_r" type="box" pos="18.4 -1.08 0.13" size="0.08 0.80 0.07" material="loop_shelf_mat"/>
    <geom name="forklift_wheel_a" type="cylinder" pos="17.25 0.15 0.27" size="0.27 0.12" euler="0 90 0" material="loop_dark_mat"/>
    <geom name="forklift_wheel_b" type="cylinder" pos="18.75 0.15 0.27" size="0.27 0.12" euler="0 90 0" material="loop_dark_mat"/>
    <geom name="east_safety_cabinet" type="box" pos="18.5 -5.0 1.02" size="0.54 0.57 1.02" material="loop_yellow_mat"/>

    <!-- Southern side: short conveyor, varied crates, and a low obstacle. -->
    <geom name="south_conveyor" type="box" pos="-5.0 -7.8 0.76" size="2.0 0.58 0.10" material="loop_dark_mat"/>
    <geom name="south_conveyor_leg_a" type="box" pos="-6.6 -7.8 0.36" size="0.10 0.12 0.36" material="loop_shelf_mat"/>
    <geom name="south_conveyor_leg_b" type="box" pos="-3.4 -7.8 0.36" size="0.10 0.12 0.36" material="loop_shelf_mat"/>
    <geom name="south_small_crate" type="box" pos="0.9 -7.7 0.30" size="0.44 0.40 0.30" material="loop_wood_mat" euler="0 0 18"/>
    <geom name="south_low_pallet" type="box" pos="5.4 -7.8 0.10" size="0.66 0.46 0.10" material="loop_wood_mat"/>
    <geom name="south_barrel_a" type="cylinder" pos="10.4 -7.7 0.48" size="0.28 0.48" material="loop_orange_mat"/>
    <geom name="south_barrel_b" type="cylinder" pos="11.2 -7.7 0.48" size="0.28 0.48" material="loop_machine_mat"/>

    <!-- Asymmetric western machine bay, far from the 2 m loop waypoint. -->
    <geom name="west_cnc_base" type="box" pos="-14.7 3.2 0.72" size="1.20 0.95 0.72" material="loop_machine_mat"/>
    <geom name="west_cnc_head" type="box" pos="-14.7 3.2 1.70" size="0.86 0.74 0.28" material="loop_blue_mat"/>
    <geom name="west_cnc_panel" type="box" pos="-13.38 3.2 1.28" size="0.10 0.30 0.40" material="loop_yellow_mat"/>
    <geom name="west_rack_bottom" type="box" pos="-14.5 -4.5 0.50" size="2.4 0.55 0.06" material="loop_shelf_mat"/>
    <geom name="west_rack_top" type="box" pos="-14.5 -4.5 1.72" size="2.4 0.55 0.06" material="loop_shelf_mat"/>
    <geom name="west_rack_post_a" type="box" pos="-16.8 -4.5 1.08" size="0.08 0.08 1.08" material="loop_orange_mat"/>
    <geom name="west_rack_post_b" type="box" pos="-12.2 -4.5 1.08" size="0.08 0.08 1.08" material="loop_orange_mat"/>
    <geom name="west_rack_crate" type="box" pos="-15.3 -4.5 0.91" size="0.48 0.42 0.34" material="loop_wood_mat"/>
    <geom name="west_column" type="cylinder" pos="-18.0 5.9 1.85" size="0.25 1.85" material="loop_wall_mat"/>

    <!-- Distinct landmarks in the wing, against the walls to preserve a wide aisle. -->
    <geom name="wing_rack_base" type="box" pos="9.3 18.8 0.52" size="0.70 1.75 0.08" material="loop_shelf_mat"/>
    <geom name="wing_rack_top" type="box" pos="9.3 18.8 1.70" size="0.70 1.75 0.08" material="loop_shelf_mat"/>
    <geom name="wing_rack_crate" type="box" pos="9.3 19.6 1.16" size="0.47 0.48 0.42" material="loop_wood_mat"/>
    <geom name="wing_machine" type="box" pos="18.5 17.8 0.91" size="0.70 1.10 0.91" material="loop_machine_mat"/>
    <geom name="wing_machine_panel" type="box" pos="17.75 17.8 1.29" size="0.07 0.36 0.32" material="loop_yellow_mat"/>
    <geom name="wing_north_pallet" type="box" pos="17.7 21.8 0.12" size="0.85 0.55 0.12" material="loop_wood_mat"/>

    <!-- Fixed, human-sized targets and low crates interrupt nominal paths.
         Aisles remain wide enough to pass on either side; no moving body is used. -->
    <geom name="loop_worker_body" type="capsule" pos="7.0 6.2 1.00" size="0.22 0.40" material="loop_worker_mat"/>
    <geom name="loop_worker_head" type="sphere" pos="7.0 6.2 1.57" size="0.17" material="loop_skin_mat"/>
    <geom name="loop_worker_leg_l" type="capsule" pos="6.87 6.2 0.35" size="0.09 0.25" material="loop_dark_mat"/>
    <geom name="loop_worker_leg_r" type="capsule" pos="7.13 6.2 0.35" size="0.09 0.25" material="loop_dark_mat"/>
    <geom name="loop_path_crate" type="box" pos="14.7 -6.0 0.43" size="0.47 0.48 0.43" euler="0 0 13" material="loop_wood_mat"/>
    <geom name="wing_worker_body" type="capsule" pos="14.0 13.0 1.00" size="0.22 0.40" material="loop_worker_mat"/>
    <geom name="wing_worker_head" type="sphere" pos="14.0 13.0 1.57" size="0.17" material="loop_skin_mat"/>
    <geom name="wing_worker_leg_l" type="capsule" pos="13.87 13.0 0.35" size="0.09 0.25" material="loop_dark_mat"/>
    <geom name="wing_worker_leg_r" type="capsule" pos="14.13 13.0 0.35" size="0.09 0.25" material="loop_dark_mat"/>
    <geom name="wing_path_crate" type="box" pos="13.0 19.0 0.36" size="0.52 0.42 0.36" euler="0 0 -17" material="loop_wood_mat"/>
  </worldbody>
</mujoco>
