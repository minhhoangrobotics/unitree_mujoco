<mujoco model="g1_23dof scene">
  <include file="g1_23dof.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall" rgba="0.5 0.5 0.6 1"/>
    <material name="box" rgba="0.8 0.4 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    
    <!-- Factory / Room environment for SLAM -->
    <!-- Outer Walls (10x10 meters room) -->
    <geom name="wall_n" pos="5 0 1" size="0.2 5 1" type="box" material="wall"/>
    <geom name="wall_s" pos="-5 0 1" size="0.2 5 1" type="box" material="wall"/>
    <geom name="wall_e" pos="0 5 1" size="5 0.2 1" type="box" material="wall"/>
    <geom name="wall_w" pos="0 -5 1" size="5 0.2 1" type="box" material="wall"/>
    
    <!-- Inner Obstacles -->
    <geom name="obs_1" pos="2 2 0.5" size="0.5 0.5 0.5" type="box" material="box"/>
    <geom name="obs_2" pos="-2 -2 0.75" size="0.5 0.5 0.75" type="box" material="box"/>
    <geom name="obs_3" pos="2 -3 0.5" size="1.0 0.2 0.5" type="box" material="box"/>
    <geom name="obs_4" pos="-3 2 0.5" size="0.2 1.0 0.5" type="box" material="box"/>
    <geom name="obs_5" pos="0 3 0.5" size="0.5 0.5 0.5" type="box" material="box" euler="0 0 45"/>
  </worldbody>
</mujoco>
